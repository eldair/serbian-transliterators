{
    "name": "serbian-transliterators",
    "displayName": "serbian-transliterators",
    "description": "Transliterates Serbian Cyrillic to Latin and vice versa",
    "version": "1.0.0",
    "license": "MIT",
    "author": {
        "name": "Kristijan Novaković",
        "email": "kristijan@codebrick.dev"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/eldair/serbian-transliterators.git"
    },
    "bugs": {
        "url": "https://github.com/eldair/serbian-transliterators/issues"
    },
    "homepage": "https://github.com/eldair/serbian-transliterators#readme",
    "publisher": "codebrick",
    "engines": {
        "vscode": "^1.140.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "serbian.toCyrillic",
                "title": "Serbian: Convert to Cyrillic (Ćirilica)"
            },
            {
                "command": "serbian.toLatin",
                "title": "Serbian: Convert to Latin (Latinica)"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "serbian.toCyrillic",
                    "group": "modification"
                },
                {
                    "command": "serbian.toLatin",
                    "group": "modification"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "pnpm run package",
        "compile": "pnpm run check-types && pnpm run lint && node esbuild.mjs",
        "watch": "pnpm run \"/watch:.*/\" --parallel",
        "watch:esbuild": "node esbuild.mjs --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "pnpm run check-types && pnpm run lint && node esbuild.mjs --production",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
        "check-types": "tsc --noEmit",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "~26.6.3",
        "@types/vscode": "^1.140.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.1.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-perfectionist": "^5.12.1",
        "eslint-plugin-unicorn": "^76.0.0",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.9.9",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0"
    },
    "overrides": {
        "diff": "^8.0.4",
        "serialize-javascript": "^7.0.6"
    }
}
